# ---------------------------------------------------------------------------
# NamelessUnSee - LOCAL DEVELOPMENT configuration.
#
#   cp .env.dev.example .env && yarn install && yarn start
#
# Everything here is safe to commit: there are no real credentials, and no
# value in this file is usable against a production deployment. It runs the
# whole app offline - no Resend account, no MaxMind key, no S3/R2 bucket, no
# moderation sidecar, and no dataset downloads on boot.
#
# For the full reference, including every production setting, see .env.example.
# NEVER deploy with this file: it disables HTTPS-only cookies, allows private
# IPs, prints one-time codes to the console, and turns off rate limiting.
# ---------------------------------------------------------------------------

BASE_URL=http://localhost:3000
PORT=3000

# Dev-only placeholders. Any string works locally; these are deliberately
# obvious so they can never be mistaken for real secrets. For a real
# deployment generate fresh values:
#   COOKIE_SECRET:    LEN=128; openssl rand -base64 96 | tr '+/' '-_' | tr -d '\n=' | head -c "$LEN"; echo
#   ALTCHA_HMAC_KEY:  openssl rand -hex 32
COOKIE_SECRET=dev-only-insecure-cookie-secret-not-for-production-use-0000000000
# Left unset on purpose: the app derives a key from COOKIE_SECRET and warns only
# in production. Set it if you want ALTCHA challenges to survive a restart.
# ALTCHA_HMAC_KEY=

# Proof-of-work difficulty. The production default (400000) adds a noticeable
# pause to every form submit; this keeps the dev loop fast.
ALTCHA_MAX_NUMBER=4000

# Plain HTTP locally, so cookies must not be marked Secure.
SECURE_COOKIES=false

# Serving to yourself means the viewer IP is 127.0.0.1 or a LAN address. Without
# this the IP-intelligence gate refuses to render any image locally.
ALLOW_PRIVATE_IPS=true

# ---------------------------------------------------------------------------
# Storage. Unencrypted-at-rest is not an option: originals are always encrypted,
# and with no key set the app derives one from COOKIE_SECRET, which is fine for
# throwaway local data.
# ---------------------------------------------------------------------------
DATA_DIR=./data

# Database backend. SQLite is the default for local development. D1 uses the
# Cloudflare REST API and requires an API token with D1 Read + D1 Write access.
DB_BACKEND=sqlite
# DB_BACKEND=d1
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_D1_DATABASE_ID=
# CLOUDFLARE_API_TOKEN=
STORAGE_BACKEND=local
# STORAGE_ENCRYPTION_KEY=
IMAGE_TTL_HOURS=24
# Hours an image's access log survives the image's deletion (0 = erase on the
# next maintenance pass). Shortening this is handy when testing the sweep.
LOG_RETENTION_AFTER_DELETE_HOURS=48
MAX_UPLOAD_MB=500
MAX_STORAGE_MB=1024

# ---------------------------------------------------------------------------
# Email. With no Resend credentials the app cannot send anything, which would
# normally make login impossible, because every login needs a second factor.
# TWOFA_CONSOLE_FALLBACK prints the code to the server console instead - login
# 2FA, signup verification, password/email recovery and account deletion all
# work from the terminal. It is refused in production for obvious reasons.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
ADMIN_NOTIFY_FROM=
ADMIN_NOTIFY_TO=
TWOFA_ENABLED=true
TWOFA_CONSOLE_FALLBACK=true
TWOFA_CHALLENGE_MIN=5
# Signup email verification defaults to on only when NODE_ENV=production. Left
# explicit here so a stray NODE_ENV cannot lock you out of your own signups.
EMAIL_VERIFICATION_REQUIRED=false

# Shown on the Terms and Privacy pages. Not a real address.
OPERATOR_NAME=Local Development
OPERATOR_CONTACT=dev@localhost.invalid
OPERATOR_JURISDICTION=Nowhere

# ---------------------------------------------------------------------------
# Registration policy. Open registration, and no blocklist download on boot so
# the app starts offline. The built-in seed list of throwaway/relay domains
# still applies; set DISPOSABLE_LIST_ENABLED=true to pull the ~8k-domain
# community list into DATA_DIR/intel.
# ---------------------------------------------------------------------------
EMAIL_DOMAIN_ALLOWLIST_ENABLED=false
DISPOSABLE_LIST_ENABLED=false

# ---------------------------------------------------------------------------
# IP intelligence. All three datasets are downloaded on first boot in
# production; disabled here so `yarn start` is instant and works offline.
# Leaving them off means VPN/Tor/datacenter traffic is not detected locally.
# ---------------------------------------------------------------------------
TOR_LIST_ENABLED=false
VPN_LISTS_ENABLED=false
MAXMIND_LICENSE_KEY=

# ---------------------------------------------------------------------------
# Moderation. The perceptual-hash blocklist is self-contained and stays on. The
# NSFW classifier needs the `moderation` sidecar from docker-compose; leave it
# off unless you are running it (`docker compose up moderation`).
# ---------------------------------------------------------------------------
MODERATION_ENABLED=true
MODERATION_HOLD_ON_REVIEW=true
NSFW_CLASSIFIER_ENABLED=false

# Off locally so hammering the app while developing never locks you out.
RATELIMIT_ENABLED=false
RATELIMIT_STORE=memory
