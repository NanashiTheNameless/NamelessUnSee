<% var pageTitle = 'NamelessUnSee - access blocked'; %>
<%- include('partials/head', { pageTitle: pageTitle }) %>
<%- include('partials/nav') %>
<div class="wrap">
  <h1>Access blocked</h1>
  <div class="card">
    <div class="error"><%= message %></div>
    <p class="muted">This image is only shown to connections that can be fully
      identified. Turn off any VPN, proxy, or Tor connection and try again from a
      normal network.</p>
    <p class="muted">This refused attempt is recorded in the uploader's access
      log- your network details, and the same browser details a successful view
      would have collected, exactly as the Privacy Policy describes. No image was
      shown to you.</p>
  </div>
</div>
<% if (typeof telemetryPath !== 'undefined' && telemetryPath) { %>
  <%- include('partials/telemetry-collect', { nonce: nonce, telemetryPath: telemetryPath }) %>
<% } %>
<%- include('partials/foot') %>
