# ---------------------------------------------------------------------------
# unsee configuration
# Copy this file to .env and fill in the values. Never commit your real .env.
# ---------------------------------------------------------------------------

# Public base URL of the deployment (used to build share links).
# When served through a Cloudflare Tunnel this is your public hostname.
BASE_URL=http://localhost:3000

# Operator identity shown in the Terms of Service and Privacy Policy. Set these
# for any public deployment- they are the legal point of contact. Have the ToS
# and Privacy Policy reviewed by counsel for your jurisdiction before launch.
OPERATOR_NAME=
OPERATOR_CONTACT=
OPERATOR_JURISDICTION=

# Port the Node server listens on (inside the container).
PORT=3000

# Source-code link shown in the footer and on the license/acknowledgement pages.
# Defaults to the upstream repository; point it at your fork if you modify the
# code (NNCL requires corresponding source to be available).
# SOURCE_URL=https://github.com/NanashiTheNameless/NamelessUnSee

# Secret used to sign session/consent cookies. MUST be a long random string.
# Generate a strong 128-char URL-safe secret with:
#   LEN=128; BYTES=$((((LEN+3)/4)*3)); openssl rand -base64 "$BYTES" | tr '+/' '-_' | tr -d '\n=' | head -c "$LEN"; echo
COOKIE_SECRET=change-me-to-a-long-random-string

# Dedicated persistent key for signing ALTCHA challenges. Keep separate from
# COOKIE_SECRET and do not rotate casually; rotation invalidates outstanding
# challenges. Generate with: openssl rand -hex 32
ALTCHA_HMAC_KEY=change-me-to-a-different-random-64-character-hex-string
# Aggressive browser proof-of-work difficulty.
ALTCHA_MAX_NUMBER=400000

# Set to "true" in production (behind HTTPS / Cloudflare) so cookies are
# only sent over secure connections.
SECURE_COOKIES=false

# Where the SQLite database and uploaded originals live (persist this volume).
DATA_DIR=./data

# Scratch space for staged upload chunks, decrypted originals and cached
# renders. Ephemeral by design, so it is kept off the persistent data volume;
# defaults to a per-process directory under the system temp dir. It needs room
# for the largest upload in flight plus RENDER_CACHE_MAX_TOTAL_MB.
# TEMP_DIR=/tmp/namelessunsee

# Database backend. Keep SQLite for local development. D1 uses Cloudflare's
# REST API and requires an API token with D1 Read + D1 Write permissions.
DB_BACKEND=sqlite
# DB_BACKEND=d1
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_D1_DATABASE_ID=
# CLOUDFLARE_API_TOKEN=

# How long an uploaded image is retained before it is purged, in hours.
IMAGE_TTL_HOURS=24

# How long an image's access log outlives the image itself, in hours. During
# this window the uploader (from "Recently deleted" on the dashboard) and
# administrators can still read who viewed it; afterwards the rows are erased
# permanently. Set to 0 to erase them on the first maintenance pass after
# deletion. Refused attempts (VPN/proxy/Tor) follow the same retention.
LOG_RETENTION_AFTER_DELETE_HOURS=48

# Default maximum upload size in megabytes. Admins can override this per user.
MAX_UPLOAD_MB=500
# Absolute parser ceiling for any per-user upload override.
MAX_UPLOAD_HARD_MB=4096
# Default active storage quota per user. Admins can override this per user.
MAX_STORAGE_MB=1024

# Chunked uploads. A reverse proxy caps how large a single request body may be
# (Cloudflare allows 100 MB on Free/Pro, 200 MB on Business, 500 MB on
# Enterprise), which would otherwise cap uploads well below MAX_UPLOAD_MB. Files
# larger than UPLOAD_CHUNK_MB are sliced by the browser and reassembled here;
# smaller ones are posted in one request as before. Keep this comfortably under
# your proxy's limit, and raise it if your plan allows more.
CHUNKED_UPLOAD_ENABLED=true
# Files at or under the threshold go as one ordinary post. Keep it under your
# proxy's limit (Cloudflare: 100 MB on Free/Pro).
UPLOAD_CHUNK_THRESHOLD_MB=95
# Slice size once chunking starts, and how many slices ride at once. Each
# in-flight slice is buffered whole in memory server-side, so peak usage per
# uploader is about UPLOAD_CHUNK_MB x UPLOAD_PARALLEL_CHUNKS: 24 x 4 costs what
# a single 95 MB chunk did, with four times the data in flight.
UPLOAD_CHUNK_MB=24
UPLOAD_PARALLEL_CHUNKS=4
# How long a partially uploaded file may sit before its staged chunks are swept.
UPLOAD_SESSION_TTL_MIN=60

# ffmpeg CPU ceiling. Every video view burns a per-viewer watermark, which is a
# full re-encode; ffmpeg otherwise takes every core on the box. FFMPEG_THREADS
# bounds one encode, FFMPEG_MAX_CONCURRENT bounds how many run at once.
FFMPEG_THREADS=2
FFMPEG_MAX_CONCURRENT=2
FFMPEG_PRESET=veryfast
# Hardware video encoding. 'auto' probes what this host actually supports and
# silently uses software when nothing works: VideoToolbox on macOS, NVENC/Quick
# Sync/AMF on Windows, NVENC/VAAPI/Quick Sync on Linux. Being listed by ffmpeg
# is not enough - each candidate is verified with a real test encode at startup.
# Set to 'off' to never try, or name one encoder (e.g. h264_nvenc) to pin it.
# Docker needs the device passed through, e.g. `devices: [/dev/dri:/dev/dri]`
# on Linux; hardware encoders are not reachable from a Linux container on
# Windows or macOS.
FFMPEG_HWACCEL=auto
# Only used by VAAPI (Linux).
FFMPEG_VAAPI_DEVICE=/dev/dri/renderD128

# Watermark tile spacing: how far apart the repeated identity mark sits.
# 1.0 packs repetitions flush against each other, higher spreads them out.
# Tighter means denser coverage but more of each mark clipped at the tile edge,
# because the rotated text is wider than its slot.
WATERMARK_TILE_SPACING=1.02
WATERMARK_TILE_PADDING=20
# Alternate columns are dropped by this fraction of the vertical step. The mark
# is tilted, so neighbours collide along that diagonal; offsetting down the
# columns breaks up where one mark's tail meets the next one's head.
# 0 disables the offset.
WATERMARK_STAGGER=0.5
# Alternate rows are shifted sideways by this fraction of the horizontal step,
# so marks interlock like brickwork instead of stacking into columns where one
# line's tail meets the next line's head. 0 disables the offset.
WATERMARK_STAGGER=0.5

# Short-lived cache of rendered video so seeking or reloading does not re-encode
# the whole file each time. Entries are bound to the viewer they were rendered
# for, so a replayed view id from anyone else still gets its own render.
RENDER_CACHE_ENABLED=true
RENDER_CACHE_TTL_SEC=300
RENDER_CACHE_MAX_ENTRY_MB=512
RENDER_CACHE_MAX_TOTAL_MB=2048
# Re-encode uploads once, at upload, to a canonical capped mp4 so per-view
# renders start from a known format and can copy the audio untouched.
VIDEO_NORMALIZE_ON_UPLOAD=true

# Stored video quality ceiling, applied once at upload. Sources already under a
# limit are never upscaled. CRF is the quality knob (lower = better + bigger;
# 23 is ffmpeg's default, 26 is visually close at far lower bitrate).
VIDEO_MAX_HEIGHT=1080
VIDEO_MAX_FPS=30
VIDEO_CRF=20
# Quality of the per-view watermarked render. Defaults to VIDEO_CRF, so views
# are served at the same quality as the stored master. Set it higher (23-26)
# only if you want to trade view quality for view-time CPU and bandwidth.
# VIDEO_VIEW_CRF=
VIDEO_MAX_BITRATE=6000k
VIDEO_AUDIO_BITRATE=128k

# Client-side image shrinking before upload. An optimisation only: the server
# re-probes, moderates and watermarks whatever arrives regardless.
# MAX_EDGE caps the longest side, so 1920 keeps everything at 1080p-class
# resolution in either orientation. Smaller sources are never upscaled.
CLIENT_IMAGE_MAX_EDGE=1920
CLIENT_IMAGE_QUALITY=0.82
# An image already within the cap is only re-encoded once it is this large.
CLIENT_IMAGE_REENCODE_ABOVE_KB=2048

# Client-side video compression (WebCodecs), same standing as the image path:
# an optimisation the server never trusts. Downscales to the ceiling the server
# would apply anyway, so the bytes shrink before crossing the network. Audio is
# remuxed untouched; anything the browser cannot handle uploads as-is and is
# normalised server-side exactly as before. Defaults follow VIDEO_MAX_HEIGHT and
# VIDEO_MAX_FPS.
CLIENT_VIDEO_COMPRESS=true
# CLIENT_VIDEO_MAX_HEIGHT=1080
# CLIENT_VIDEO_MAX_FPS=30
CLIENT_VIDEO_BITRATE_KBPS=6000

# ---------------------------------------------------------------------------
# Encrypted media storage. New originals are always encrypted with AES-256-GCM
# before they are written to local storage or uploaded to Cloudflare R2. Use a
# 64-character hex key in production; if omitted, COOKIE_SECRET derives it.
# ---------------------------------------------------------------------------
# Production recommendation: r2. Use local only for development.
STORAGE_BACKEND=local
STORAGE_ENCRYPTION_KEY=
# Cloudflare R2 S3 API credentials. R2_ACCOUNT_ID derives the standard endpoint;
# set R2_ENDPOINT instead when using a custom endpoint.
R2_ACCOUNT_ID=
# R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_FORCE_PATH_STYLE=false
# Generic S3-compatible fallback (only needed when STORAGE_BACKEND=s3).
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_FORCE_PATH_STYLE=false

# ---------------------------------------------------------------------------
# Rate limiting (per client IP; uploads and reports are per user). The default
# in-memory store suits a single instance. For multiple instances, share the
# counters through Redis: set RATELIMIT_STORE=redis, point REDIS_URL at your
# server, and run `yarn add redis`. If Redis is missing or down the limiter
# falls back to in-memory and keeps serving.
# ---------------------------------------------------------------------------
RATELIMIT_ENABLED=true
RATELIMIT_STORE=memory
# Admins and owners bypass every limiter. Login/signup are unaffected: those
# requests are unauthenticated, so there is no staff account to exempt yet.
RATELIMIT_EXEMPT_STAFF=true
# REDIS_URL=redis://localhost:6379
RL_LOGIN_MAX=30           # per RL_LOGIN_WINDOW_MIN (default 15) minutes
RL_SIGNUP_MAX=10          # per RL_SIGNUP_WINDOW_MIN (default 60) minutes
RL_UPLOAD_MAX=120         # per RL_UPLOAD_WINDOW_MIN (default 60) minutes, per user
# Chunk requests get their own, far looser budget: one large upload is many
# requests (a 4 GB file at 24 MB is ~170), so counting them against
# RL_UPLOAD_MAX would rate-limit a single legitimate upload.
RL_UPLOAD_CHUNK_MAX=5000  # per RL_UPLOAD_CHUNK_WINDOW_MIN (default 60) minutes, per user
RL_VIEW_MAX=600           # per RL_VIEW_WINDOW_SEC (default 60) seconds; shared by page + render
RL_TELEMETRY_MAX=600      # per RL_TELEMETRY_WINDOW_SEC (default 60) seconds
# Router ceilings, per IP per minute. A single page can issue several requests,
# so these sit well above ordinary browsing.
RL_PUBLIC_MAX=1200
RL_ADMIN_MAX=900
RL_AUTH_MAX=600
RL_ALTCHA_MAX=600

# ---------------------------------------------------------------------------
# Registration policy.
# The disposable/alias blocklist is always on: a built-in seed list (throwaway
# inboxes plus relay providers such as Firefox Relay, Proton Pass, SimpleLogin,
# addy.io and Apple Hide My Email) merged with the disposable-email-domains
# community list (~8k domains). The list is downloaded once, cached under
# DATA_DIR/intel, refreshed on the interval below, and matched entirely locally.
# Set DISPOSABLE_LIST_ENABLED=false to rely on the built-in seed list alone.
DISPOSABLE_LIST_ENABLED=true
DISPOSABLE_REFRESH_HOURS=24
# DISPOSABLE_LIST_URL=https://raw.githubusercontent.com/disposable-email-domains/disposable-email-domains/main/disposable_email_blocklist.conf
# DISPOSABLE_EMAIL_DOMAINS=              # replaces the built-in seed list
#
# Allowlist mode is the stricter policy. While it is true, ONLY the domains in
# EMAIL_DOMAIN_ALLOWLIST may register and every other address is refused,
# including corporate, university and self-hosted domains. Leave it false for
# open registration (the blocklist above still applies).
# The built-in allowlist covers the mainstream providers: Gmail, Outlook,
# iCloud, Yahoo, Proton, Tuta, Fastmail, GMX, Zoho, Yandex, QQ, Naver and the
# large ISP mailboxes. Setting EMAIL_DOMAIN_ALLOWLIST replaces that list
# entirely rather than extending it. Both the allowlist and the blocklist match
# a domain and any subdomain of it.
EMAIL_DOMAIN_ALLOWLIST_ENABLED=false
# EMAIL_DOMAIN_ALLOWLIST=example.com,gmail.com,icloud.com
#
# Signup email verification. Defaults to ON when NODE_ENV=production and OFF
# otherwise, so a production deploy starts requiring a six-digit code before the
# account becomes usable. It needs working Resend credentials (see below);
# without them, signups cannot complete.
# EMAIL_VERIFICATION_REQUIRED=true
# Per-address registration quota, counted per email address only (the per-IP
# signup pressure is handled by RL_SIGNUP_MAX above), so a shared office or
# campus address is not capped as a group.
RL_SIGNUP_EMAIL_MAX=3            # per RL_SIGNUP_EMAIL_WINDOW_MIN (default 1440) minutes
# Signups from one network within 15 minutes before registration is throttled.
# Volume only- the mail domain is never counted, so a shared office or campus
# address is not penalised for the mix of providers behind it.
RL_SIGNUP_BURST_MAX=15
# RL_SIGNUP_EMAIL_WINDOW_MIN=1440
# Minimum account age before an admin-granted "trusted" rank takes effect.
NEW_ACCOUNT_TRUST_DELAY_HOURS=24
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Content moderation. Scans the uploaded original once on upload; videos are
# sampled at equal distances throughout (5-15 frames based on duration).
#   - Perceptual-hash blocklist (self-managed, always on): auto-quarantines
#     uploads matching a hash you added from the admin review page.
#   - NSFW classifier sidecar (optional): routes suspected content to HUMAN
#     REVIEW only. It never auto-bans or auto-reports. Docker Compose runs it
#     as the internal `moderation` service and caches the ONNX model in its own
#     volume. If the sidecar is unavailable, uploads are held for admin review
#     when NSFW_FAIL_CLOSED=true.
#   - Known-CSAM providers (Cloudflare / PhotoDNA / Arachnid): scaffolding only,
#     disabled- they require vetted access. See docs/CONTEXT.md.
# Nothing here ever auto-bans a user; account actions require an admin.
# ---------------------------------------------------------------------------
MODERATION_ENABLED=true
# Hold review-flagged images until an admin decides. Keep the comment on its
# own line: the .env loader does not strip trailing comments, and a boolean
# is matched with an anchored pattern, so `true  # ...` would read as false.
MODERATION_HOLD_ON_REVIEW=true
MODERATION_PHASH_THRESHOLD=10    # legacy 64-bit blocklist entries: max Hamming distance
MODERATION_PDQ_THRESHOLD=31      # 256-bit PDQ entries: max Hamming distance (PDQ convention)
NSFW_CLASSIFIER_ENABLED=true
NSFW_MODEL=onnx-community/nsfw-classifier-ONNX
NSFW_SAFETY_MODEL=OwenElliott/image-safety-classifier-m
NSFW_BINARY_MODEL=onnx-community/nsfw_image_detection-ONNX
# Internal moderation sidecar URL. Docker Compose sets this automatically.
# NSFW_SERVICE_URL=http://moderation:8787
NSFW_SERVICE_TIMEOUT_MS=15000
NSFW_THRESHOLD=0.80
NSFW_FAIL_CLOSED=true
# Future known-CSAM providers (leave disabled unless you have vetted access):
MOD_CLOUDFLARE_ENABLED=false
MOD_PHOTODNA_ENABLED=false
PHOTODNA_ENDPOINT=
PHOTODNA_API_KEY=
MOD_ARACHNID_ENABLED=false
ARACHNID_ENDPOINT=
ARACHNID_API_KEY=

# ---------------------------------------------------------------------------
# IP intelligence- 100% LOCAL detection (no per-viewer third-party calls).
# The app auto-downloads and auto-refreshes these datasets on its own; viewer
# IPs never leave your server. Country is always available for free from
# Cloudflare's CF-IPCountry header. Detection runs only on the image VIEW route.
# ---------------------------------------------------------------------------

# Refuse VPN/proxy/Tor viewers, and refuse when the viewer can't be assessed.
BLOCK_PROXIES=true
BLOCK_ON_UNKNOWN=true
BLOCK_DATACENTER=true

# Allow loopback/LAN addresses (enable ONLY for local development so rendering
# works without a real public IP). Keep false in production.
ALLOW_PRIVATE_IPS=false

# --- MaxMind GeoLite2 (geolocation + network/ASN) --------------------------
# Preferred geo/ASN source. Get a FREE licence key at
# https://www.maxmind.com/en/geolite2/signup and paste it here; the app then
# downloads GeoLite2-ASN and GeoLite2-City and keeps them up to date (verifying
# MaxMind's published SHA-256). Alternatively, mount your own .mmdb files at the
# paths below and leave the key blank. Without either, geo falls back to the
# Cloudflare country header only.
# NOTE: since 2024 MaxMind redirects downloads to an R2 presigned URL. The app
# follows redirects automatically; if you run a strict egress firewall, allow
# HTTPS to download.maxmind.com AND
# mm-prod-geoip-databases.a2649acb697e2c09b632799562c076f2.r2.cloudflarestorage.com
MAXMIND_LICENSE_KEY=
# MAXMIND_ASN_DB=./data/intel/GeoLite2-ASN.mmdb
# MAXMIND_CITY_DB=./data/intel/GeoLite2-City.mmdb
MAXMIND_REFRESH_HOURS=72

# --- Tor exit list ---------------------------------------------------------
TOR_LIST_ENABLED=true
# TOR_LIST_URL=https://check.torproject.org/torbulkexitlist
TOR_REFRESH_HOURS=6

# --- VPN / datacenter ranges (X4BNet/lists_vpn) ----------------------------
# Both variables take a comma-separated list of URLs, and each source may mix
# IPv4 and IPv6 CIDRs. The X4BNet defaults cover IPv4 only, so append an IPv6
# source of your choosing to extend coverage, e.g.:
#   DATACENTER_LIST_URL=https://raw.githubusercontent.com/X4BNet/lists_vpn/main/output/datacenter/ipv4.txt,https://example.invalid/datacenter-ipv6.txt
VPN_LISTS_ENABLED=true
# VPN_LIST_URL=https://raw.githubusercontent.com/X4BNet/lists_vpn/main/output/vpn/ipv4.txt
# DATACENTER_LIST_URL=https://raw.githubusercontent.com/X4BNet/lists_vpn/main/output/datacenter/ipv4.txt
VPN_REFRESH_HOURS=24

# ---------------------------------------------------------------------------
# Optional: notify admins by email when a new account needs approval, an upload
# is flagged for moderation, or a report is submitted.
# Requires a Resend API key. Leave RESEND_API_KEY empty to disable (the app
# will just log pending approvals to the server console instead).
# ---------------------------------------------------------------------------
RESEND_API_KEY=
ADMIN_NOTIFY_FROM=NamelessUnSee <NamelessUnSee@example.invalid>
ADMIN_NOTIFY_TO=admin@example.invalid

# Email 2FA is required by default. Resend must be configured for login codes.
TWOFA_ENABLED=true
# Development-only fallback. Keep false in production; otherwise codes are logged.
TWOFA_CONSOLE_FALLBACK=false
TWOFA_CHALLENGE_MIN=5

# At most 10 leak reports per account per 24 hours by default.
RL_REPORT_WINDOW_MIN=1440
RL_REPORT_MAX=10
# Max size per leak-report screenshot, in megabytes.
MAX_REPORT_MB=25

# ---------------------------------------------------------------------------
# Cloudflare Tunnel (used by docker-compose, not by the Node app itself).
# Create a tunnel in the Cloudflare Zero Trust dashboard and paste its token.
# ---------------------------------------------------------------------------
TUNNEL_TOKEN=
